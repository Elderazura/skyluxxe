# Copy to .env.local for local development. On Netlify, set these under
# Site configuration → Environment variables. Never commit real values.

# --- Enquiry delivery (at least one of the two is REQUIRED in production) ---
# Without either, the enquiry form answers "delivery unavailable" in production.

# Resend API key — sends each enquiry as an email.
RESEND_API_KEY=
# Sender address. Must be on a domain verified in Resend. If unset, Resend's
# test sender is used, which only delivers to the Resend account owner.
ENQUIRY_FROM_EMAIL="Skyluxxe Concierge <enquiries@skyluxxe.ae>"
# Where enquiries are sent (default: concierge@skyluxxe.ae) and an optional cc.
ENQUIRY_TO_EMAIL=concierge@skyluxxe.ae
ENQUIRY_BACKUP_EMAIL=

# Optional: also POST each enquiry as JSON to this URL (CRM, Zapier, Slack…).
ENQUIRY_WEBHOOK_URL=

# --- Spam protection (strongly recommended; set BOTH or neither) ---
# Cloudflare Turnstile. The site key shows the widget; the secret key makes the
# server verify it. With only one set the form either fails or is unprotected.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional overrides for values shown in the footer and structured data ---
NEXT_PUBLIC_DED_LICENSE=
NEXT_PUBLIC_VAT_TRN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_PINTEREST=
